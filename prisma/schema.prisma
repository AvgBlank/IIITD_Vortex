// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("NEXT_PUBILC_DATABASE_URL")
}

model AdminUser {
    id       String  @id
    name     String
    email    String  @unique
    password String?
}

model BorrowerUser {
    id       String  @id
    name     String
    email    String  @unique
    password String?
}

model LenderUser {
    id       String  @id
    name     String
    email    String  @unique
    password String?
}
